# Copy this file to .env and replace every value marked CHANGE_ME.
# Never commit .env or production credentials.

APP_VERSION=0.0.1
ROOT_PATH=/
DEBUG=0
CORS_ORIGINS=http://localhost
UVICORN_PORT=8090
UVICORN_CONCURRENCY=1
WEBSOCKET_TIMEOUT=60

# Authentication: generate separate, high-entropy values for each environment.
TOKEN=CHANGE_ME
SERVICE_KEY=CHANGE_ME
EXTERNAL_AUTH_PROVIDER=token
WS_AUTH_PROVIDER=token
INTERNAL_AUTH_PROVIDER=token

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=anti_fraud
POSTGRES_USER=anti_fraud
POSTGRES_PASSWORD=CHANGE_ME

# Object storage
S3_HOST=minio
S3_PORT=9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKETS_PREFIX=anti_fraud
S3_USE_HTTPS=0
S3_DISABLE_INITIALIZATION=0

# Processing and retention
DECODING_ENABLED=1
DECODING_PROCESS_COUNT=1
SAVE_ERROR_CONTENT=0
RETENTION_WORKERS_COUNT=1
